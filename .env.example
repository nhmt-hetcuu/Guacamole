# Phiên bản Guacamole (guacd và web phải cùng phiên bản)
GUAC_VERSION=1.6.0

# Cổng web Guacamole trên máy host — Nginx trỏ vào cổng này
GUAC_PORT=8005

# Database PostgreSQL nội bộ
POSTGRES_DB=guacamole_db
POSTGRES_USER=guacamole
POSTGRES_PASSWORD=change_this_to_a_secure_password

# Bắt buộc mã 2 lớp (TOTP) khi đăng nhập (true/false)
TOTP_ENABLED=false
TOTP_ISSUER=Guacamole Homelab
